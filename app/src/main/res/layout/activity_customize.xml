<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Top Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCustomize"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Tùy chỉnh hình nền khóa"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PREVIEW CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="380dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#DDDDDD"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#121212">

                    <ImageView
                        android:id="@+id/ivCustomizePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyWallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Áp dụng làm hình nền khóa"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#4CAF50"
                        app:cornerRadius="20dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="16dp"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 1: Layout Styles -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kiểu Bố Cục"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <RadioGroup
                        android:id="@+id/rgLayoutStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/rbStandard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Month agenda (Xem tháng chuẩn)" />

                        <RadioButton
                            android:id="@+id/rbSplit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Split clock hole (Tách giữa đồng hồ)" />

                        <RadioButton
                            android:id="@+id/rbWeekly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekly tasks (Xem tuần &amp; Nhiệm vụ)" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: Color Customization -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Màu Sắc Lịch"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Row 1: Past Day -->
                    <LinearLayout
                        android:id="@+id/rowColorPast"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Màu ngày đã qua" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivColorPast"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#CCCCCC" />
                    </LinearLayout>

                    <!-- Row 2: Future Day -->
                    <LinearLayout
                        android:id="@+id/rowColorFuture"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Màu ngày sắp tới" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivColorFuture"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#CCCCCC" />
                    </LinearLayout>

                    <!-- Row 3: Today -->
                    <LinearLayout
                        android:id="@+id/rowColorToday"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Màu nổi bật ngày hôm nay" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivColorToday"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#CCCCCC" />
                    </LinearLayout>

                    <!-- Row 4: Text Color -->
                    <LinearLayout
                        android:id="@+id/rowColorText"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Màu chữ &amp; Số" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivColorText"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#CCCCCC" />
                    </LinearLayout>

                    <!-- Row 5: Background Color -->
                    <LinearLayout
                        android:id="@+id/rowColorBg"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Màu nền Lịch" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivColorBg"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#CCCCCC" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickImage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🖼️ Chọn ảnh nền tùy chỉnh từ Thư viện" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 3: Font Style -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kiểu Phông Chữ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleFont"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <Button
                            android:id="@+id/btnFontSans"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="System" />

                        <Button
                            android:id="@+id/btnFontSerif"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Serif" />

                        <Button
                            android:id="@+id/btnFontMono"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Mono" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 4: Sliders Position & Scale -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vị Trí &amp; Kích Thước"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vị trí dọc (Y-Offset)"
                        android:textSize="14sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/seekYOffset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="10"
                        android:valueTo="90"
                        android:value="60" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tỉ lệ phóng to/thu nhỏ (Scale)"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/seekScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="50"
                        android:valueTo="150"
                        android:value="100" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 5: Switches -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMondayFirst"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bắt đầu tuần từ Thứ Hai"
                        app:showText="false"
                        android:textOn=""
                        android:textOff="" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchWeekNumbers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hiển thị số thứ tự tuần"
                        app:showText="false"
                        android:textOn=""
                        android:textOff="" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMinimalist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hiển thị chấm nhỏ tối giản cho sự kiện"
                        app:showText="false"
                        android:textOn=""
                        android:textOff="" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
